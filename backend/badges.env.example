# Copy to /etc/grapegram/badges.env and fill on the VPS. Never commit real values.
GRP_PORT=8080
GRP_STATE_FILE=/var/lib/grapegram/backend_state.json
GRP_SIGNING_KEY_FILE=/etc/grapegram/ed25519_private.pem
GRP_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
GRP_GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_GITHUB_TOKEN
GRP_GITHUB_REPO=kesakuuta/grapeGram
GRP_GITHUB_BRANCH=main
